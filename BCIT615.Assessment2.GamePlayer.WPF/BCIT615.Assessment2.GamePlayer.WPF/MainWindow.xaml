<Window x:Class="BCIT615.Assessment2.GamePlayer.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chess Maze Game Player"
        Height="850"
        Width="1100"
        MinHeight="700"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Chessboard -->
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Chess Maze Game"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Move the player through the chess maze"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="0,0,0,20"/>

            <UniformGrid x:Name="BoardGrid"
                         Rows="6"
                         Columns="6"
                         Width="642"
                         Height="593"
                         HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Game controls -->
        <ScrollViewer Grid.Column="1"
                      Margin="25,10,5,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Game Information"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Current Position"/>
                <TextBlock x:Name="CurrentPositionText"
                           Text="(5, 0)"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,5,0,20"/>

                <TextBlock Text="Target Position"/>
                <TextBlock x:Name="TargetPositionText"
                           Text="(0, 5)"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,5,0,20"/>

                <Separator Margin="0,0,0,15"/>

                <TextBlock Text="Destination Row"/>
                <TextBox x:Name="RowInput"
                         Height="35"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Destination Column"/>
                <TextBox x:Name="ColumnInput"
                         Height="35"
                         Margin="0,5,0,15"/>

                <Button Content="Move"
                        Height="40"
                        Margin="0,5,0,10"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="MoveButton_Click"/>

                <Button Content="Restart"
                        Height="40"
                        Margin="0,0,0,15"
                        Click="RestartButton_Click"/>

                <TextBlock Text="Game Status"
                           FontSize="18"
                           FontWeight="Bold"/>

                <TextBlock x:Name="StatusText"
                           Text="Ready to play"
                           Foreground="Green"
                           Margin="0,8,0,15"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Move History"
                           FontSize="18"
                           FontWeight="Bold"/>

                <ListBox x:Name="MoveHistoryList"
                         Height="120"
                         Margin="0,5,0,15"/>

                <Separator Margin="0,0,0,15"/>

                <!-- Save game -->
                <TextBlock Text="Save Game"
                           FontSize="18"
                           FontWeight="Bold"/>

                <TextBlock Text="Enter a name for this game"
                           Margin="0,8,0,3"/>

                <TextBox x:Name="SaveNameInput"
                         Height="35"
                         Margin="0,0,0,10"/>

                <Button Content="Save Game"
                        Height="40"
                        Background="#15803D"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="SaveGameButton_Click"/>

                <!-- Load game -->
                <TextBlock Text="Saved Games"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,20,0,8"/>

                <ComboBox x:Name="SavedGamesComboBox"
                          Height="35"
                          DisplayMemberPath="Name"
                          Margin="0,0,0,10"/>

                <Button Content="Refresh Saved Games"
                        Height="35"
                        Margin="0,0,0,8"
                        Click="RefreshSavedGamesButton_Click"/>

                <Button Content="Load Selected Game"
                        Height="40"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="LoadGameButton_Click"/>

                <Button Content="Delete Selected Game"
                        Click="DeleteGameButton_Click"
                        Height="35"
                        Margin="0,5,0,0"
                        Background="Firebrick"
                        Foreground="White"/>        
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
